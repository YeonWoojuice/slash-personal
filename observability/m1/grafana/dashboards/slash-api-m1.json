{
  "uid": "slash-api-m1",
  "title": "Slash API | M1 Testbed",
  "tags": ["slash", "m1", "local"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by endpoint, method, status",
      "description": "Routed HTTP requests per second. The uri label is the matched route template, never a raw URL.",
      "datasource": { "type": "prometheus", "uid": "slash-m1-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri, method, status) (rate(http_server_requests_seconds_count{service=\"slash-api\",environment=\"local\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx error ratio",
      "description": "5xx requests divided by all application requests; Actuator traffic is excluded.",
      "datasource": { "type": "prometheus", "uid": "slash-m1-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{service=\"slash-api\",environment=\"local\",status=~\"5..\",uri!~\"/actuator.*\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{service=\"slash-api\",environment=\"local\",uri!~\"/actuator.*\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx / all"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request latency",
      "description": "Average request duration by matched endpoint and method, in seconds.",
      "datasource": { "type": "prometheus", "uid": "slash-m1-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri, method) (rate(http_server_requests_seconds_sum{service=\"slash-api\",environment=\"local\",uri!~\"/actuator.*\"}[$__rate_interval])) / clamp_min(sum by (uri, method) (rate(http_server_requests_seconds_count{service=\"slash-api\",environment=\"local\",uri!~\"/actuator.*\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{method}} {{uri}} mean"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "PostgreSQL connections in API pool",
      "description": "Hikari active and idle connections for the API's PostgreSQL datasource.",
      "datasource": { "type": "prometheus", "uid": "slash-m1-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active{service=\"slash-api\",environment=\"local\"})",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "sum(hikaricp_connections_idle{service=\"slash-api\",environment=\"local\"})",
          "legendFormat": "idle"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DB query latency",
      "description": "Mean and p95 jOOQ query duration. No SQL text or query parameters are labels.",
      "datasource": { "type": "prometheus", "uid": "slash-m1-prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(slash_db_query_seconds_sum{service=\"slash-api\",environment=\"local\"}[$__rate_interval])) / clamp_min(sum(rate(slash_db_query_seconds_count{service=\"slash-api\",environment=\"local\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "mean"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(slash_db_query_seconds_bucket{service=\"slash-api\",environment=\"local\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
