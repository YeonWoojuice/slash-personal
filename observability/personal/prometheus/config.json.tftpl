{
  "global": {
    "scrape_interval": "15s",
    "evaluation_interval": "15s"
  },
  "scrape_configs": [
    {
      "job_name": "slash-api-personal",
      "metrics_path": "/actuator/prometheus",
      "scrape_timeout": "5s",
      "dns_sd_configs": [
        {
          "names": ["core.${name}.internal"],
          "type": "A",
          "port": 9091,
          "refresh_interval": "10s"
        }
      ]
    }
  ]
}
