# ---------------------------------------------------------------------------
# 로컬 실행에 필요한 환경 변수
#
#   cp .env.example .env      # 복사한 뒤 값을 채운다
#   ./gradlew bootRun
#
# .env 는 저장소에 올리지 않는다. (.gitignore 대상)
# 값은 팀 채널에서 받는다.
#
# 시험(./gradlew test)은 이 값을 무시하고 항상 로컬 임시 인증으로 돈다.
#
# 값 뒤의 # 는 주석으로 보고 잘라낸다. 값에 # 를 넣어야 하면 따옴표로 감싼다.
#   KEY=값 # 설명    -> "값"
#   KEY="값 # 설명"  -> "값 # 설명"
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Cognito
#
#   세 값을 모두 채우면 실제 Cognito 토큰 검증으로 동작한다.
#   비워 두면 로컬 임시 인증을 쓴다.
#
#     curl -H "Authorization: Bearer alice" http://localhost:8080/api/v1/me
#
#   COGNITO_ISSUER_URI 가 전환 스위치다.
#   이 값이 비어 있으면 나머지를 채워도 임시 인증으로 동작한다.
#   반대로 이 값만 채우고 나머지를 빠뜨리면 기동 시점에 멈춘다.
# ---------------------------------------------------------------------------

# User Pool 발급자 주소
# 예: https://cognito-idp.ap-northeast-2.amazonaws.com/ap-northeast-2_XXXXXXXXX
COGNITO_ISSUER_URI=

# App Client ID (secret 없는 public 클라이언트)
COGNITO_CLIENT_ID=

# Hosted UI 도메인 아래의 userInfo 주소
# Access Token 에는 이메일이 없어서 최초 로그인 때 여기서 받아온다.
# 예: https://<도메인>.auth.ap-northeast-2.amazoncognito.com/oauth2/userInfo
COGNITO_USER_INFO_URI=

# ---------------------------------------------------------------------------
# 다른 서비스 주소
#
#   기본값이 로컬 포트라 평소에는 건드릴 것이 없다.
#   다른 포트로 띄웠을 때만 주석을 풀고 채운다.
#
#   빈 값으로 두면 안 된다 — 빈 문자열이 그대로 주입되어 기본값이 무시된다.
#   그래서 예시를 주석으로 둔다.
# ---------------------------------------------------------------------------

# slash-nlu. 기본값 http://localhost:8001 (Dockerfile EXPOSE 8001)
# 8000 은 slash-llm 이라 그리로 보내면 NLU 요청이 엉뚱한 곳으로 간다.
#NLU_BASE_URL=http://localhost:8001
