# .env.local로 복사해서 쓴다 (커밋 금지 — .gitignore 처리됨).
# 값은 slash-infra의 environments/local/cognito에서 `terraform output`으로 확인한다.

VITE_COGNITO_REGION=ap-northeast-2
VITE_COGNITO_USER_POOL_ID=ap-northeast-2_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# 로그아웃 전용(Cognito 고유 방식) — terraform output의 hosted_domain 값
VITE_COGNITO_DOMAIN=https://xxxxxxxxxxxxxxxxxxxxxxxxxx.auth.ap-northeast-2.amazoncognito.com

# frontend-api-contract.md §9 TBD — 백엔드가 dev API 주소를 알려주면 채운다.
VITE_API_BASE_URL=

# clarity.microsoft.com 프로젝트 ID. PROD 빌드에서만 초기화된다(lib/clarity.ts) — 로컬 dev는 비워둬도 무방.
VITE_CLARITY_PROJECT_ID=
