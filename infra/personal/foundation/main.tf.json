{
  "resource": {
    "aws_ecr_repository": {
      "images": {
        "for_each": "${toset([\"api\", \"nlu\", \"inference\", \"prometheus\", \"grafana\", \"db-test\"])}",
        "name": "${var.name}/${each.key}",
        "image_tag_mutability": "IMMUTABLE",
        "force_delete": false,
        "image_scanning_configuration": {
          "scan_on_push": true
        }
      }
    },
    "aws_ecr_lifecycle_policy": {
      "images": {
        "for_each": "${aws_ecr_repository.images}",
        "repository": "${each.value.name}",
        "policy": "{\"rules\": [{\"rulePriority\": 1, \"description\": \"Remove untagged images after seven days\", \"selection\": {\"tagStatus\": \"untagged\", \"countType\": \"sinceImagePushed\", \"countUnit\": \"days\", \"countNumber\": 7}, \"action\": {\"type\": \"expire\"}}]}"
      }
    },
    "aws_cognito_user_pool": {
      "test": {
        "name": "${var.name}",
        "username_attributes": [
          "email"
        ],
        "auto_verified_attributes": [
          "email"
        ],
        "admin_create_user_config": {
          "allow_admin_create_user_only": true
        },
        "password_policy": {
          "minimum_length": 12,
          "require_lowercase": true,
          "require_uppercase": true,
          "require_numbers": true,
          "require_symbols": true
        }
      }
    },
    "aws_cognito_user_pool_client": {
      "web": {
        "name": "${var.name}-web",
        "user_pool_id": "${aws_cognito_user_pool.test.id}",
        "generate_secret": false,
        "allowed_oauth_flows_user_pool_client": true,
        "allowed_oauth_flows": [
          "code"
        ],
        "allowed_oauth_scopes": [
          "openid",
          "email",
          "profile"
        ],
        "supported_identity_providers": [
          "COGNITO"
        ],
        "callback_urls": [
          "http://localhost:5173/callback"
        ],
        "logout_urls": [
          "http://localhost:5173"
        ],
        "prevent_user_existence_errors": "ENABLED"
      },
      "lambdaops_operator": {
        "name": "${var.name}-lambdaops-operator",
        "user_pool_id": "${aws_cognito_user_pool.test.id}",
        "generate_secret": false,
        "allowed_oauth_flows_user_pool_client": true,
        "allowed_oauth_flows": [
          "code"
        ],
        "allowed_oauth_scopes": [
          "openid",
          "${aws_cognito_resource_server.lambdaops.identifier}/incidents.read"
        ],
        "supported_identity_providers": [
          "COGNITO"
        ],
        "callback_urls": [
          "http://localhost:8765/callback"
        ],
        "prevent_user_existence_errors": "ENABLED",
        "access_token_validity": 60,
        "id_token_validity": 60,
        "refresh_token_validity": 1,
        "token_validity_units": {
          "access_token": "minutes",
          "id_token": "minutes",
          "refresh_token": "days"
        },
        "enable_token_revocation": true
      }
    },
    "aws_cognito_user_pool_domain": {
      "test": {
        "domain": "${var.name}-${var.account_id}",
        "user_pool_id": "${aws_cognito_user_pool.test.id}"
      }
    },
    "aws_cognito_resource_server": {
      "lambdaops": {
        "identifier": "lambdaops",
        "name": "LambdaOps Incident reads",
        "user_pool_id": "${aws_cognito_user_pool.test.id}",
        "scope": [
          {
            "scope_name": "incidents.read",
            "scope_description": "Read LambdaOps incidents and their alarm history"
          }
        ]
      }
    }
  },
  "output": {
    "repositories": {
      "value": "${{for k,v in aws_ecr_repository.images : k => v.repository_url}}"
    },
    "cognito": {
      "value": {
        "issuer_uri": "https://cognito-idp.ap-northeast-2.amazonaws.com/${aws_cognito_user_pool.test.id}",
        "client_id": "${aws_cognito_user_pool_client.web.id}",
        "user_info_uri": "https://${aws_cognito_user_pool_domain.test.domain}.auth.ap-northeast-2.amazoncognito.com/oauth2/userInfo"
      }
    },
    "lambdaops_auth": {
      "description": "Non-secret operator login and M3 JWT settings. Slash web client remains separate.",
      "value": {
        "account_id": "${var.account_id}",
        "region": "ap-northeast-2",
        "issuer_uri": "https://cognito-idp.ap-northeast-2.amazonaws.com/${aws_cognito_user_pool.test.id}",
        "client_id": "${aws_cognito_user_pool_client.lambdaops_operator.id}",
        "authorization_base_url": "https://${aws_cognito_user_pool_domain.test.domain}.auth.ap-northeast-2.amazoncognito.com",
        "redirect_uri": "http://localhost:8765/callback",
        "read_scope": "${aws_cognito_resource_server.lambdaops.identifier}/incidents.read"
      }
    },
    "lambdaops_m3_auth_tfvars": {
      "description": "Copy only after foundation apply. API Gateway and read Lambda consume the same configured scope.",
      "value": {
        "jwt_issuer": "https://cognito-idp.ap-northeast-2.amazonaws.com/${aws_cognito_user_pool.test.id}",
        "jwt_audience": "${aws_cognito_user_pool_client.lambdaops_operator.id}",
        "read_authorization_scope": "${aws_cognito_resource_server.lambdaops.identifier}/incidents.read"
      }
    }
  }
}
