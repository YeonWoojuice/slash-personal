name: test

on:
  pull_request:
  push:
    branches: [main, dev]

jobs:
  test:
    runs-on: ubuntu-latest
    services:
      # valkey는 command 오버라이드가 필요 없어 services로 충분하다.
      valkey:
        image: valkey/valkey:8-alpine
        ports: ["6379:6379"]
        options: >-
          --health-cmd "valkey-cli ping"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
    steps:
      - uses: actions/checkout@v4
      - name: Start Postgres (docker-compose.yml과 동일 설정)
        run: |
          # GitHub Actions의 services: 블록은 command 오버라이드를 지원하지 않는다.
          # TimeZoneContractTest가 서버 기본 timezone(pg_settings.reset_val)까지
          # 검사하는데, TZ 환경변수만으로는 이 GUC가 안 바뀌어서(docker-compose.yml
          # 주석 참고) -c timezone=Asia/Seoul을 직접 커맨드로 넘겨야 한다.
          docker run --detach --name postgres \
            --publish 5432:5432 \
            --env POSTGRES_DB=slash \
            --env POSTGRES_USER=slash \
            --env POSTGRES_PASSWORD=slash \
            --env TZ=Asia/Seoul \
            postgres:16 postgres -c timezone=Asia/Seoul
          until docker exec postgres pg_isready -U slash -d slash; do sleep 1; done
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"
      - run: ./gradlew --no-daemon test
      - name: Stop Postgres
        if: always()
        run: docker rm --force postgres || true

  container-build:
    if: github.event_name == 'pull_request' || github.ref == 'refs/heads/dev' || github.ref == 'refs/heads/main'
    needs: test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-buildx-action@v3
      - uses: docker/build-push-action@v6
        with:
          context: .
          platforms: linux/amd64
          load: true
          push: false
          tags: slash-api:test
          cache-from: type=gha
          cache-to: type=gha,mode=max
      # 이미지가 뜨는지 보려면 DB 가 있어야 한다. 기동 때 Flyway 마이그레이션이 돌아서
      # DB 가 없으면 애플리케이션이 아예 시작하지 못한다.
      - name: Start Postgres, Valkey
        run: |
          docker run --detach --name postgres --network host \
            --env POSTGRES_DB=slash \
            --env POSTGRES_USER=slash \
            --env POSTGRES_PASSWORD=slash \
            --env TZ=Asia/Seoul \
            postgres:16 postgres -c timezone=Asia/Seoul
          docker run --detach --name valkey --network host valkey/valkey:8-alpine
          until docker exec postgres pg_isready -U slash -d slash; do sleep 1; done
      - name: Verify container health
        run: |
          # --network host 로 붙여야 컨테이너 안의 localhost 가 러너의 DB 를 가리킨다.
          # 컨테이너 자신의 localhost 를 보면 아무것도 없다.
          docker run --detach --name slash-api-test --network host \
            --env DB_URL=jdbc:postgresql://127.0.0.1:5432/slash \
            --env DB_USERNAME=slash \
            --env DB_PASSWORD=slash \
            --env VALKEY_HOST=127.0.0.1 \
            slash-api:test
          curl --fail --silent --show-error \
            --retry 30 --retry-delay 1 --retry-connrefused --retry-all-errors \
            http://127.0.0.1:8080/actuator/health
      - name: Show container logs on failure
        if: failure()
        run: docker logs slash-api-test 2>&1 | tail -40
      - name: Stop containers
        if: always()
        run: docker rm --force slash-api-test postgres valkey || true

  publish-image:
    if: github.event_name == 'push' && (github.ref == 'refs/heads/dev' || github.ref == 'refs/heads/main')
    needs: [test, container-build]
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    env:
      AWS_REGION: ap-northeast-2
      ECR_REGISTRY: 061039804626.dkr.ecr.ap-northeast-2.amazonaws.com
      ECR_REPOSITORY: slash-api
    steps:
      - uses: actions/checkout@v4
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: arn:aws:iam::061039804626:role/slash-api-cicd
          aws-region: ${{ env.AWS_REGION }}
      - uses: aws-actions/amazon-ecr-login@v2
      - name: Check immutable image tag
        id: image
        run: |
          found=$(aws ecr batch-get-image \
            --repository-name "$ECR_REPOSITORY" \
            --image-ids imageTag="sha-$GITHUB_SHA" \
            --query 'length(images)' \
            --output text)
          echo "exists=$([ "$found" = "1" ] && echo true || echo false)" >> "$GITHUB_OUTPUT"
      - uses: docker/setup-buildx-action@v3
        if: steps.image.outputs.exists != 'true'
      - uses: docker/build-push-action@v6
        if: steps.image.outputs.exists != 'true'
        with:
          context: .
          platforms: linux/amd64
          push: true
          tags: ${{ env.ECR_REGISTRY }}/${{ env.ECR_REPOSITORY }}:sha-${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  # dev에 push된 이미지를 slash-infra의 helm/slash-api/values-dev.yaml에 바로 반영한다 —
  # ArgoCD가 이 파일을 보고 있어서(automated selfHeal), 이 커밋이 곧 dev 환경 배포다
  # (slash-infra 이슈 #24, docs/aws-architecture.md §9). INFRA_PUSH_TOKEN은 slash-infra
  # 저장소 Contents:write만 있는 fine-grained PAT.
  bump-dev-tag:
    if: github.event_name == 'push' && github.ref == 'refs/heads/dev'
    needs: [test, container-build, publish-image]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          repository: LikeLionTeam4/slash-infra
          ref: dev
          token: ${{ secrets.INFRA_PUSH_TOKEN }}
      - name: Bump image.tag in values-dev.yaml
        run: |
          FILE="helm/slash-api/values-dev.yaml"
          TAG="sha-${GITHUB_SHA}"

          # 줄 끝 주석은 남긴다. `.*` 로 줄 전체를 갈아치우면 그 줄에 적어 둔 설명이 사라진다.
          # (실제로 첫 배포 때 "아직 비워둠 —" 주석이 이렇게 지워졌다)
          sed -i -E "s|^(\s{2}tag:)[^#]*(\s#.*)?$|\1 \"${TAG}\"\2|" "$FILE"

          # 치환이 안 됐는데 통과하면, 이미지는 올라갔는데 배포 태그는 그대로인 채로
          # 초록불이 된다. 파일 구조가 바뀌었을 때 조용히 어긋나는 것을 여기서 막는다.
          if ! grep -q "tag: \"${TAG}\"" "$FILE"; then
            echo "::error::${FILE} 의 image.tag 를 바꾸지 못했다. 파일 구조를 확인할 것"
            grep -n "tag:" "$FILE"
            exit 1
          fi
          grep -n "tag:" "$FILE"
      - name: Commit and push (retry on race with other services)
        run: |
          git config user.name "slash-infra-cd-bot"
          git config user.email "actions@users.noreply.github.com"
          git add helm/slash-api/values-dev.yaml

          # 커밋할 것이 없는 경우만 조용히 끝낸다. `|| exit 0` 은 그 경우와 커밋이 다른
          # 이유로 실패한 경우를 구분하지 않아, 실패까지 초록불로 덮는다.
          if git diff --cached --quiet; then
            echo "이미 같은 태그다. 커밋할 변경이 없다."
            exit 0
          fi
          git commit -m "chore(slash-api): bump dev image tag to sha-${GITHUB_SHA:0:12}"

          for i in 1 2 3 4 5; do
            git push origin dev && exit 0
            git fetch origin dev
            # rebase 가 충돌하면 저장소가 rebase 중 상태로 남아 남은 재시도가 모두 헛돈다.
            # 다른 서비스와 같은 줄이 겹친 것이므로 사람이 봐야 한다.
            if ! git rebase origin/dev; then
              git rebase --abort || true
              echo "::error::values-dev.yaml 이 다른 변경과 충돌했다. 직접 확인이 필요하다"
              exit 1
            fi
            sleep $((RANDOM % 5 + 1))
          done
          echo "::error::dev 브랜치 push 재시도 5회 모두 실패"
          exit 1
