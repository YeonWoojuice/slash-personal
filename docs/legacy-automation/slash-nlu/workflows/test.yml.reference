name: test

on:
  pull_request:
  push:
    branches: [main, dev, "codex/**"]

jobs:
  pytest:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Checkout Backend contract source
        uses: actions/checkout@v4
        with:
          repository: LikeLionTeam4/slash-api
          ref: dev
          path: .contract/slash-api
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip
      - run: python -m pip install -r requirements.txt
      - run: python -m pytest
        env:
          BACKEND_TASK_TYPE_SOURCE: .contract/slash-api/src/main/java/com/likelion/slash/common/enums/TaskType.java
      - run: python -m compileall -q main.py models.py analyzer.py intents.py summary.py scripts tests

  container-build:
    if: github.event_name == 'pull_request' || github.ref == 'refs/heads/dev' || github.ref == 'refs/heads/main'
    needs: pytest
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-buildx-action@v3
      - uses: docker/build-push-action@v6
        with:
          context: .
          platforms: linux/amd64
          load: true
          push: false
          tags: slash-nlu:test
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - name: Verify container health
        run: |
          docker run --detach --name slash-nlu-test --publish 8001:8001 slash-nlu:test
          curl --fail --silent --show-error \
            --retry 30 --retry-delay 1 --retry-connrefused --retry-all-errors \
            http://127.0.0.1:8001/health \
            | python -c 'import json, sys; body = json.load(sys.stdin); assert body == {"status": "UP", "analyzerReady": True}, body'
          curl --fail --silent --show-error \
            http://127.0.0.1:8001/ready \
            | python -c 'import json, sys; body = json.load(sys.stdin); assert body == {"status": "UP", "analyzerReady": True}, body'
          curl --fail --silent --show-error \
            --header 'Content-Type: application/json' \
            --data '{"requestId":"container-smoke","text":"오늘 서울 날씨 어때","now":"2026-08-13T10:00:00+09:00"}' \
            http://127.0.0.1:8001/internal/v1/nlu/analyze \
            | python -c 'import json, sys; body = json.load(sys.stdin); assert body["decision"] == "TASK", body; assert body["taskType"] == "WEATHER_LOOKUP", body; assert body["parameters"]["location"] == "서울", body'
          curl --fail --silent --show-error \
            --header 'Content-Type: application/json' \
            --data '{"requestId":"summary-smoke","taskId":"task-smoke","text":"The project team built a natural language service for user commands. Clear slash commands are handled before complex language analysis. File searches extract a query without exposing private local paths. Weather requests extract a location before the backend calls an external provider. Long documents are summarized by selecting important source sentences. Every result is validated before it is stored by the backend."}' \
            http://127.0.0.1:8001/internal/v1/nlu/summaries/extractive \
            | python -c 'import json, sys; body = json.load(sys.stdin); assert body["engine"] == "EXTRACTIVE", body; assert body["algorithm"] == "TFIDF_CENTROID", body; assert body["requestId"] == "summary-smoke", body; assert body["taskId"] == "task-smoke", body'
      - name: Stop test container
        if: always()
        run: docker rm --force slash-nlu-test || true

  publish-image:
    if: github.event_name == 'push' && (github.ref == 'refs/heads/dev' || github.ref == 'refs/heads/main')
    needs: [pytest, container-build]
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    env:
      AWS_REGION: ap-northeast-2
      ECR_REGISTRY: 061039804626.dkr.ecr.ap-northeast-2.amazonaws.com
      ECR_REPOSITORY: slash-nlu
    steps:
      - uses: actions/checkout@v4
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: arn:aws:iam::061039804626:role/slash-nlu-cicd
          aws-region: ${{ env.AWS_REGION }}
      - uses: aws-actions/amazon-ecr-login@v2
      - name: Check immutable image tag
        id: image
        run: |
          found=$(aws ecr batch-get-image \
            --repository-name "$ECR_REPOSITORY" \
            --image-ids imageTag="sha-$GITHUB_SHA" \
            --query 'length(images)' \
            --output text)
          if [ "$found" = "1" ]; then
            echo "exists=true" >> "$GITHUB_OUTPUT"
          else
            echo "exists=false" >> "$GITHUB_OUTPUT"
          fi
      - uses: docker/setup-buildx-action@v3
        if: steps.image.outputs.exists != 'true'
      - uses: docker/build-push-action@v6
        if: steps.image.outputs.exists != 'true'
        with:
          context: .
          platforms: linux/amd64
          push: true
          tags: ${{ env.ECR_REGISTRY }}/${{ env.ECR_REPOSITORY }}:sha-${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  # dev에 push된 이미지를 slash-infra의 helm/slash-nlu/values-dev.yaml에 바로 반영한다 —
  # ArgoCD가 이 파일을 보고 있어서(automated selfHeal), 이 커밋이 곧 dev 환경 배포다
  # (slash-infra 이슈 #24, docs/aws-architecture.md §9). INFRA_PUSH_TOKEN은 slash-infra
  # 저장소 Contents:write만 있는 fine-grained PAT.
  bump-dev-tag:
    if: github.event_name == 'push' && github.ref == 'refs/heads/dev'
    needs: [pytest, container-build, publish-image]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          repository: LikeLionTeam4/slash-infra
          ref: dev
          token: ${{ secrets.INFRA_PUSH_TOKEN }}
      - name: Bump image.tag in values-dev.yaml
        run: |
          FILE="helm/slash-nlu/values-dev.yaml"
          TAG="sha-${GITHUB_SHA}"

          # 줄 끝 주석은 남긴다. `.*` 로 줄 전체를 갈아치우면 그 줄에 적어 둔 설명이 사라진다.
          sed -i -E "s|^(\s{2}tag:)[^#]*(\s#.*)?$|\1 \"${TAG}\"\2|" "$FILE"

          # 치환이 안 됐는데 통과하면, 이미지는 올라갔는데 배포 태그는 그대로인 채로
          # 초록불이 된다. 파일 구조가 바뀌었을 때 조용히 어긋나는 것을 여기서 막는다.
          if ! grep -q "tag: \"${TAG}\"" "$FILE"; then
            echo "::error::${FILE} 의 image.tag 를 바꾸지 못했다. 파일 구조를 확인할 것"
            grep -n "tag:" "$FILE"
            exit 1
          fi
          grep -n "tag:" "$FILE"
      - name: Commit and push (retry on race with other services)
        run: |
          git config user.name "slash-infra-cd-bot"
          git config user.email "actions@users.noreply.github.com"
          git add helm/slash-nlu/values-dev.yaml

          # 커밋할 것이 없는 경우만 조용히 끝낸다. `|| exit 0`는 그 경우와 커밋이 다른
          # 이유로 실패한 경우를 구분하지 않아, 실패까지 초록불로 덮는다.
          if git diff --cached --quiet; then
            echo "이미 같은 태그다. 커밋할 변경이 없다."
            exit 0
          fi
          git commit -m "chore(slash-nlu): bump dev image tag to sha-${GITHUB_SHA:0:12}"

          for i in 1 2 3 4 5; do
            git push origin dev && exit 0
            git fetch origin dev
            # rebase가 충돌하면 저장소가 rebase 중 상태로 남아 남은 재시도가 모두 헛돈다.
            # 다른 서비스와 같은 줄이 겹친 것이므로 사람이 봐야 한다.
            if ! git rebase origin/dev; then
              git rebase --abort || true
              echo "::error::values-dev.yaml이 다른 변경과 충돌했다. 직접 확인이 필요하다"
              exit 1
            fi
            sleep $((RANDOM % 5 + 1))
          done
          echo "::error::dev 브랜치 push 재시도 5회 모두 실패"
          exit 1
